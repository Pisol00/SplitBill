# Copy to .env and adjust as needed. Matches the db service in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://splitbill:splitbill@localhost:5434/splitbill
# Used by the test suite. The database name must end in _test; it is recreated on every run.
TEST_DATABASE_URL=postgresql+psycopg://splitbill:splitbill@localhost:5434/splitbill_test
